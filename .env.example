# ─── DB ────────────────────────────────────────────────────────────
# 앱 런타임용. Supabase 는 Transaction pooler(:6543) 를 쓴다.
#   Supabase 대시보드 > Connect > Transaction pooler
# 서버리스(Vercel)에서 커넥션이 새지 않게 하려면 반드시 pooler 를 쓴다.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# 마이그레이션(npm run db:push)용 direct connection.
#   Supabase 대시보드 > Connect > Direct connection
# pooler 는 prepared statement 를 지원하지 않아 스키마 변경에 쓸 수 없다.
# 로컬 개발만 할 때는 비워둬도 된다 (DATABASE_URL 로 떨어진다).
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# 로컬 Postgres 예시 (npm run db:local)
#   DATABASE_URL="postgresql://postgres:postgres@localhost:55432/postgres"

# Neon 을 쓸 경우 — URL 에 neon.tech 가 있으면 HTTP 드라이버로 자동 전환된다
#   DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ─── 앱 ────────────────────────────────────────────────────────────
# 생성되는 공유/관리 링크의 기준 URL
# 로컬: http://localhost:3000 / 배포: https://<프로젝트>.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
